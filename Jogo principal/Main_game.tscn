[sub_resource type="GDScript" id="GDScript_tkcjf"]
script/source = "extends TileMapLayer

# Sinal personalizado que avisa a cena principal sobre o clique no tile
signal tile_clicado(categoria_construcao: String)


func _ready() -> void:
	pass


func _unhandled_input(event: InputEvent) -> void:
	# Usamos _unhandled_input para garantir que o clique só seja detectado se NÃO foi consumido pela UI/Menus
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		var mouse_pos = get_global_mouse_position()
		
		# Converte a posição do mouse para as coordenadas da grade (grid) do TileMap
		var grid_pos = local_to_map(to_local(mouse_pos))
		
		# Pega os dados do tile clicado nessa posição
		var tile_data: TileData = get_cell_tile_data(grid_pos)
		if tile_data == null:
			return

		# Checa se o tile é marcado como \"clicavel\" de forma segura
		var is_clicavel: bool = _obter_custom_data(tile_data, \"clicavel\", false)
		if not is_clicavel:
			return
		
		# Busca \"categoria\" (e tenta \"tipo\" como fallback caso algum tile antigo use esse nome)
		var categoria: String = _obter_custom_data(tile_data, \"categoria\", \"\")
		if categoria == \"\":
			categoria = _obter_custom_data(tile_data, \"tipo\", \"\")
		
		if categoria == \"\":
			push_warning(\"TileMapLayer: Tile clicado não possui 'categoria' ou 'tipo' definido no Custom Data.\")
			return

		# Limpa o dicionário de construções do Global
		_resetar_dicionario_construcoes()
		
		# Se essa categoria/construção existir no Global, marca como true
		if Global and \"construcoes\" in Global and Global.construcoes.has(categoria):
			Global.construcoes[categoria] = true
		
		# Emite o sinal com a categoria do tile clicado
		tile_clicado.emit(categoria)


# Função auxiliar para garantir que só 1 construção fique true por vez
func _resetar_dicionario_construcoes() -> void:
	if Global and \"construcoes\" in Global and Global.construcoes is Dictionary:
		for chave in Global.construcoes:
			Global.construcoes[chave] = false


# ==============================================================================
# FUNÇÃO DE SEGURANÇA PARA CUSTOM DATA (EVITA O CRASH NO GODOT 4)
# ==============================================================================
func _obter_custom_data(tile_data: TileData, nome_camada: String, valor_padrao = null):
	if tile_data == null:
		return valor_padrao
	
	# Checa se o TileSet realmente tem a camada cadastrada antes de solicitar os dados
	if tile_set and tile_set.has_custom_data_layer_by_name(nome_camada):
		return tile_data.get_custom_data(nome_camada)
	
	return valor_padrao


# Função de teste de troca de tiles
func _on_teste_troca_pressed() -> void:
	var cells = get_used_cells()
	
	for cell in cells:
		var tile_data = get_cell_tile_data(cell)
		if tile_data == null:
			continue
		
		var categoria = _obter_custom_data(tile_data, \"categoria\", \"\")
		if categoria == \"\":
			categoria = _obter_custom_data(tile_data, \"tipo\", \"\")

		if categoria == \"casa1\":
			var source_id = get_cell_source_id(cell)
			var coord_agua = Vector2i(0, 0) # Ajuste a coordenada do atlas se necessário
			
			set_cell(cell, source_id, coord_agua)
"

