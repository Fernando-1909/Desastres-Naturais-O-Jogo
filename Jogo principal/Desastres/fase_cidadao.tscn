layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[center]Neste momento, você assume o controle da jornada de um [b]Cidadão[/b] no epicentro da enchente.

Sua missão é tomar decisões conscientes de autoproteção à medida que o nível da água avança, desviando de armadilhas mortais até alcançar o abrigo seguro da Defesa Civil no morro.[/center]"
fit_content = true

